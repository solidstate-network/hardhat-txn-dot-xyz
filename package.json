    "@types/node": "^22.15.29",
    "hardhat": "^3.0.0-next.13",
    "husky": "^9.1.7",
    "knip": "^5.59.1",
    "lint-staged": "github:ItsNickBarry/lint-staged#hide-all",
    "prettier": "^3.5.3",
